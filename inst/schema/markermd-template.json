{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rundel.github.io/markermd/schema/markermd-template.json",
  "title": "markermd grading template",
  "description": "A markermd grading template: the questions and validation rules used to grade student assignments. The assignment document itself is referenced by source.path and re-parsed on load.",
  "type": "object",
  "required": ["format_version", "questions"],
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "type": "string",
      "description": "Template format version (e.g. \"3.0\")."
    },
    "source": {
      "type": "object",
      "description": "Reference to the assignment document the template was built from.",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "Path to the assignment .qmd/.Rmd, absolute or relative to this template file."
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "type": "string",
          "description": "ISO-8601 creation timestamp."
        },
        "created_by": {
          "type": "string"
        }
      }
    },
    "questions": {
      "type": "array",
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "node_type_enum": {
      "type": "string",
      "enum": [
        "Any node",
        "Heading",
        "Markdown",
        "Chunk",
        "Code block",
        "Raw Block",
        "Div",
        "Bullet list",
        "Ordered list",
        "Block quote",
        "Table",
        "Figure",
        "Horizontal rule",
        "Definition list",
        "Line block"
      ]
    },
    "node_type": {
      "oneOf": [
        { "$ref": "#/$defs/node_type_enum" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/node_type_enum" },
          "minItems": 1,
          "uniqueItems": true
        }
      ]
    },
    "question": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "description": "Unique question identifier."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Unique question display name."
        },
        "node_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Pandoc heading/div ids of the document sections this question targets."
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" }
        },
        "filters": {
          "type": "array",
          "items": { "$ref": "#/$defs/filter_group" },
          "description": "Filter groups narrowing the question's node set before rules evaluate. Conditions within a group are ANDed; groups are ORed."
        },
        "points": {
          "type": "number",
          "description": "Deprecated per-question points. Scoring moved into the rubric; accepted for backward compatibility with older templates and ignored on load."
        }
      }
    },
    "rule": {
      "type": "object",
      "required": ["node_type", "verb"],
      "additionalProperties": false,
      "properties": {
        "node_type": { "$ref": "#/$defs/node_type" },
        "verb": {
          "type": "string",
          "enum": [
            "has at least",
            "has at most",
            "has between",
            "has content",
            "lacks content",
            "has name"
          ]
        },
        "min": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 },
        "count": { "type": "integer", "minimum": 0 },
        "pattern": { "type": "string" }
      },
      "oneOf": [
        {
          "properties": { "verb": { "const": "has between" } },
          "required": ["min", "max"]
        },
        {
          "properties": { "verb": { "enum": ["has at least", "has at most"] } },
          "required": ["count"]
        },
        {
          "properties": { "verb": { "enum": ["has content", "lacks content", "has name"] } },
          "required": ["pattern"]
        }
      ]
    },
    "filter_node_type_enum": {
      "type": "string",
      "enum": [
        "Heading",
        "Markdown",
        "Chunk",
        "Code block",
        "Raw Block",
        "Div",
        "Bullet list",
        "Ordered list",
        "Block quote",
        "Table",
        "Figure",
        "Horizontal rule",
        "Definition list",
        "Line block"
      ]
    },
    "filter_condition": {
      "type": "object",
      "required": ["type", "value"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["node type", "has class", "has id", "has text", "has label", "has option", "has engine"],
          "description": "q2r predicate this condition maps to: 'node type' becomes is(<pandoc class>); the others map onto has_class()/has_id()/has_text()/has_label()/has_option()/has_engine()."
        },
        "value": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" }, "minItems": 1 }
          ],
          "description": "Node kind or array of kinds (combined as logical OR) for 'node type'; a Quarto cell option ('eval' or 'eval: false') for 'has option'; a cell engine name (e.g. 'r') for 'has engine'; class name, id, regex pattern, or glob pattern otherwise."
        },
        "negate": {
          "type": "boolean",
          "description": "When true the predicate is negated (logical NOT)."
        }
      },
      "if": {
        "properties": { "type": { "const": "node type" } }
      },
      "then": {
        "properties": {
          "value": {
            "oneOf": [
              { "$ref": "#/$defs/filter_node_type_enum" },
              {
                "type": "array",
                "items": { "$ref": "#/$defs/filter_node_type_enum" },
                "minItems": 1
              }
            ]
          }
        }
      }
    },
    "filter_group": {
      "type": "object",
      "required": ["conditions"],
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/filter_condition" },
          "minItems": 1,
          "description": "Conditions combined with logical AND."
        },
        "negate": {
          "type": "boolean",
          "description": "When true the whole group's predicate is negated (logical NOT around the ANDed conditions)."
        }
      }
    }
  }
}
